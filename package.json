{
  "name": "ideaspaces-plugin",
  "version": "0.3.25",
  "description": "Ideaspace Protocol for Claude Code and Cowork — durable awareness, deliberate capture, optional sync.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "homepage": "https://ideaspaces.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IdeaSpaces-xyz/claude-code-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/IdeaSpaces-xyz/claude-code-plugin/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:hook": "node build-hook.mjs",
    "build:reference": "node reference.mjs",
    "vendor": "node vendor.mjs",
    "check:generated": "npm run build:reference && npm run build:hook && git diff --exit-code -- reference/ dist/awareness-hook.js dist/capture-nudge-hook.js",
    "check:vendor": "node scripts/check-vendor.mjs",
    "lint:skills": "node scripts/lint-skills.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@ideaspaces/protocol": "github:IdeaSpaces-xyz/ideaspace-protocol#075cb7e326760614d62cb2236bccf0eaba62fa12",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  }
}
